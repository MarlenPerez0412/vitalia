# Copiar a backend/.env. Rutas relativas a la carpeta backend/.
VOSK_MODEL_PATH=models/vosk-model-es-0.42
VOSK_SAMPLE_RATE=16000
# Nombre o ruta del ejecutable de FFmpeg (necesario para audio/webm, ogg y mp4).
FFMPEG_BINARY=ffmpeg
# Origenes permitidos separados por coma.
CORS_ORIGINS=http://localhost:4200
MAX_UPLOAD_MB=10
LOAD_MODEL_ON_STARTUP=true
TEMP_DIR=temp

# Entretenimiento (opcional; vacio = catalogo local)
TMDB_API_KEY=
TICKETMASTER_API_KEY=
NEWS_API_KEY=
YOUTUBE_API_KEY=
